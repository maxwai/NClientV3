<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="surfaceRaised">@color/surface_raised</item><item name="surfaceOutline">@color/outline_soft</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="colorPrimary">@color/colorPrimary</item><item name="colorPrimaryContainer">@color/gold_container</item><item name="colorPrimaryVariant">@color/canvas</item>
        <item name="colorPrimarySurface">@color/surface</item><item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorSecondary">@color/colorAccent</item><item name="colorOnSecondary">@color/on_gold</item>
        <item name="colorAccent">@color/colorAccent</item><item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item><item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/canvas</item><item name="android:windowBackground">@color/canvas</item>
        <item name="android:textColorPrimary">@color/text_primary</item><item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="actionBarSize">64dp</item><item name="toolbarStyle">@style/Widget.NClient.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.NClient.Button</item><item name="chipStyle">@style/Widget.NClient.Chip</item>
        <item name="cardViewStyle">@style/ModernCardView</item><item name="materialCardViewStyle">@style/Widget.NClient.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.NClient.BottomNavigation</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NClient.Dialog</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.NClient.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NClient.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.NClient.Large</item>
        <item name="android:statusBarColor">@color/canvas</item><item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/canvas</item>
        <item name="android:windowAnimationStyle">@style/Animation.NClient.Window</item>
        <item name="navHeaderGradient">@drawable/drawer_backdrop</item>
    </style>
    <style name="AppTheme.Black" parent="AppTheme">
        <item name="android:statusBarColor">#000000</item><item name="android:navigationBarColor">#000000</item>
        <item name="colorSurface">#000000</item><item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item><item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimaryVariant">#000000</item><item name="cardViewStyle">@style/BlackCardView</item>
    </style>
    <style name="ModernCardView" parent="CardView">
        <item name="cardCornerRadius">20dp</item><item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>
    <style name="BlackCardView" parent="ModernCardView"><item name="cardBackgroundColor">#111411</item></style>
    <style name="ShapeAppearance.NClient.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent"><item name="cornerSize">14dp</item></style>
    <style name="ShapeAppearance.NClient.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent"><item name="cornerSize">20dp</item></style>
    <style name="ShapeAppearance.NClient.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent"><item name="cornerSize">28dp</item></style>
    <style name="TextAppearance.NClient.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">serif</item><item name="android:fontFamily">serif</item>
        <item name="android:textSize">36sp</item><item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:letterSpacing">-0.025</item><item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.NClient.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">serif</item><item name="android:fontFamily">serif</item>
        <item name="android:textSize">24sp</item><item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.NClient.Eyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item><item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">?attr/colorPrimary</item><item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.NClient.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item><item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.NClient.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item><item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="Widget.NClient.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">?android:attr/colorBackground</item><item name="titleTextAppearance">@style/TextAppearance.NClient.CardTitle</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item><item name="subtitleTextColor">?android:attr/textColorSecondary</item>
        <item name="contentInsetStartWithNavigation">12dp</item>
    </style>
    <style name="Widget.NClient.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item><item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item><item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item>
    </style>
    <style name="Widget.NClient.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">?attr/surfaceRaised</item><item name="chipStrokeColor">?attr/colorPrimaryContainer</item>
        <item name="chipStrokeWidth">1dp</item><item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipMinHeight">36dp</item><item name="chipCornerRadius">12dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <style name="Widget.NClient.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item><item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item><item name="strokeColor">?attr/surfaceOutline</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>
    <style name="Widget.NClient.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item><item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_tint</item><item name="itemTextColor">@color/nav_tint</item>
        <item name="itemRippleColor">?attr/colorPrimaryContainer</item><item name="itemHorizontalTranslationEnabled">false</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.NClient.Nav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.NClient.Nav</item>
    </style>
    <style name="TextAppearance.NClient.Nav" parent="TextAppearance.MaterialComponents.Caption"><item name="android:textSize">11sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="ThemeOverlay.NClient.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NClient.Large</item>
    </style>
    <style name="Animation.NClient.Window" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>
<style parent="" name="Accent.Gold"><item name="colorControlActivated">@color/colorAccent</item><item name="colorPrimary">@color/colorPrimary</item><item name="colorAccent">@color/colorAccent</item><item name="colorSecondary">@color/colorAccent</item><item name="colorPrimaryContainer">@color/gold_container</item></style>
<style parent="" name="Accent.Jade">
    <item name="colorPrimary">@color/accent_jade</item><item name="colorAccent">@color/accent_jade</item>
    <item name="colorSecondary">@color/accent_jade</item><item name="colorControlActivated">@color/accent_jade</item>
    <item name="colorPrimaryContainer">@color/accent_jade_container</item>
</style>
<style parent="" name="Accent.Ocean">
    <item name="colorPrimary">@color/accent_ocean</item><item name="colorAccent">@color/accent_ocean</item>
    <item name="colorSecondary">@color/accent_ocean</item><item name="colorControlActivated">@color/accent_ocean</item>
    <item name="colorPrimaryContainer">@color/accent_ocean_container</item>
</style>
<style parent="" name="Accent.Amethyst">
    <item name="colorPrimary">@color/accent_amethyst</item><item name="colorAccent">@color/accent_amethyst</item>
    <item name="colorSecondary">@color/accent_amethyst</item><item name="colorControlActivated">@color/accent_amethyst</item>
    <item name="colorPrimaryContainer">@color/accent_amethyst_container</item>
</style>
<style parent="" name="Accent.Rose">
    <item name="colorPrimary">@color/accent_rose</item><item name="colorAccent">@color/accent_rose</item>
    <item name="colorSecondary">@color/accent_rose</item><item name="colorControlActivated">@color/accent_rose</item>
    <item name="colorPrimaryContainer">@color/accent_rose_container</item>
</style>
<style parent="" name="Accent.Copper">
    <item name="colorPrimary">@color/accent_copper</item><item name="colorAccent">@color/accent_copper</item>
    <item name="colorSecondary">@color/accent_copper</item><item name="colorControlActivated">@color/accent_copper</item>
    <item name="colorPrimaryContainer">@color/accent_copper_container</item>
</style>
</resources>
